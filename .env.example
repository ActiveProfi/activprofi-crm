# Скопируйте этот файл в .env и замените пароли.
# Файл .env не коммитится.

# Адрес. По умолчанию сервер доступен только на этом компьютере.
HOST=127.0.0.1
PORT=3212

# Файл базы SQLite. Каталог создаётся сам.
DATABASE_PATH=./data/crm.sqlite

# Первый администратор. Пароль не короче 8 символов.
# Если база пустая, администратор создаётся при запуске.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Администратор

# 1 — записать синтетические демо-данные, только в пустую базу.
# 0 — не записывать. Пароль нужен только при SEED_DEMO=1.
SEED_DEMO=0
SEED_PASSWORD=

# Срок сессии в днях.
SESSION_DAYS=14

# 1 — ставить у cookie флаг Secure. Для http://127.0.0.1 оставьте 0.
COOKIE_SECURE=0

# Воронка для лидов из парсера «Исток». Пусто — воронка outbound или первая в базе.
INTEGRATION_PIPELINE_ID=

# Токен бота @CRM_ActivProfi_Bot. Та же папка и тот же файл, что ADMIN_PASSWORD.
# Сервер читает строку сам при запуске. Не вставляйте токен в код и не коммитьте .env.
TELEGRAM_BOT_TOKEN=

# 1 — учебный режим без настоящего Telegram. Для обычной работы оставьте пустым.
TELEGRAM_MOCK=
TELEGRAM_MOCK_SEED=

# Почта для писем клиентам. Пароль не вставляйте в код и не коммитьте .env.
# Яндекс: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SECURE=1, SMTP_USER — полный ящик,
# SMTP_PASS — пароль приложения из настроек Яндекса (не обычный пароль входа).
# Mail.ru: SMTP_HOST=smtp.mail.ru, SMTP_PORT=465, SMTP_SECURE=1, тоже пароль приложения.
# SMTP_SECURE=1 — шифрование сразу (порт 465). SMTP_SECURE=0 — без шифрования, только для своей учебной проверки.
# Пустой SMTP_SECURE и порт 587 — шифрование включается после соединения, если сервер его предлагает.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=АктивПрофи

# Входящие ответы по IMAP пока не читаются. Когда это появится, понадобятся IMAP_HOST, IMAP_PORT, IMAP_USER, IMAP_PASS.
